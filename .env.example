# TMDB: usa el token de lectura v4 (preferido) o la API key v3
# https://www.themoviedb.org/settings/api
TMDB_READ_TOKEN=
TMDB_API_KEY=

# URL pública (metadatos / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de datos (Turso). Sin definir -> SQLite local en ./local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Better Auth: genera el secreto con `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Opcional: login con Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
